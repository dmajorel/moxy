# Build artifacts
/bin/
*.exe

# Frontend dependencies and build output. package-lock.json is deliberately
# NOT ignored: npm ci and the CI cache both need it.
node_modules
dist/
coverage/
*.tsbuildinfo

# Coverage profiles. Written only when MOXY_COVER is set, which in practice
# means CI, where they are uploaded as artifacts rather than committed.
cover.out

# Local configuration: holds Proxmox API tokens, never commit
config.local.json
*.local.json
.env
.env.*

# Tooling
.DS_Store

# Git worktrees created by tooling under .claude/
.claude/worktrees/
