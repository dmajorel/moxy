{
  "auth": {
    "mode": "proxy-header",
    "header": "X-Forwarded-User",
    "trustedProxies": ["127.0.0.1/32"]
  },
  "maintenance": {
    "mode": "ssh-key",
    "sshKey": {
      "keyFile": "/etc/moxy/ssh/id_ed25519"
    },
    "ssh": {
      "user": "moxy",
      "port": 22,
      "knownHostsFile": "/etc/moxy/ssh/known_hosts",
      "connectTimeout": "2s",
      "timeout": "20s"
    }
  },
  "thresholds": {
    "memory": 0.80,
    "cpu": 0.80,
    "storage": 0.80
  },
  "clusters": [
    {
      "id": "qualification",
      "name": "Qualification",
      "color": "#378ADD",
      "urls": [
        "https://prox-qual-2201-cit:8006",
        "https://prox-qual-2202-cit:8006",
        "https://prox-qual-2203-cit:8006"
      ],
      "tokenId": "moxy@pve!ro",
      "secretEnv": "MOXY_SECRET_QUALIFICATION",
      "tls": {
        "mode": "insecure"
      },
      "timeout": "4s",
      "maintenance": {
        "enabled": true,
        "allowedUsers": ["alice", "bob"],
        "hosts": {
          "prox-qual-2201-cit": "10.0.0.11",
          "prox-qual-2202-cit": "10.0.0.12",
          "prox-qual-2203-cit": "10.0.0.13"
        }
      }
    },
    {
      "id": "preproduction",
      "name": "Préproduction",
      "color": "#EF9F27",
      "urls": [
        "https://prox-pprd-2301-cit:8006",
        "https://prox-pprd-2302-cit:8006",
        "https://prox-pprd-2303-cit:8006"
      ],
      "tokenId": "moxy@pve!ro",
      "secretEnv": "MOXY_SECRET_PREPRODUCTION",
      "tls": {
        "mode": "pinned",
        "caFile": "/etc/moxy/ca/preproduction-pve-root-ca.pem"
      },
      "timeout": "4s"
    },
    {
      "id": "production",
      "name": "Production",
      "color": "#1D9E75",
      "urls": [
        "https://prox-prod-2401-cit:8006"
      ],
      "tokenId": "moxy@pve!ro",
      "secretEnv": "MOXY_SECRET_PRODUCTION",
      "tls": {
        "mode": "system"
      },
      "timeout": "6s"
    }
  ]
}
