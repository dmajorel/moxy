# moxy behind an authenticating reverse proxy (Caddy 2.6+; the commented
# basic_auth variant at the bottom of this file wants 2.8, where the directive
# was renamed from basicauth).
#
# Comments are in English like the rest of the tooling; docs/DEPLOIEMENT.md
# explains the reasoning in French.
#
# moxy holds hypervisor tokens and authenticates nobody itself. What it does is
# refuse any request that did not come through the component that authenticates
# -- see the "auth" block of config.json, mode "proxy-header". This file is that
# component. Pair it with:
#
#   {"auth": {"mode": "proxy-header",
#             "header": "X-Forwarded-User",
#             "trustedProxies": ["127.0.0.1/32"]}}
#
# Check with: caddy validate --config deploy/Caddyfile

moxy.interne.example {
	# Caddy obtains and renews the certificate itself over ACME. For an
	# internal name no public CA can answer for, point it at files instead:
	#   tls /etc/ssl/moxy.crt /etc/ssl/moxy.key

	encode zstd gzip

	# NOBODY asserts an identity to moxy but this proxy. An X-Forwarded-User
	# sent by the client is dropped here, before any handler runs; forward_auth
	# below sets it from the answer of the authenticating component. Skipping
	# this is worse than having no check at all: the journal would then name
	# whoever the caller claimed to be.
	request_header -X-Forwarded-User

	# Liveness and readiness stay unauthenticated, deliberately and in step with
	# moxyd, which exempts exactly these two paths: an orchestrator has no
	# identity to present, and a probe failing on authentication restarts a
	# daemon that works. They carry a status and a build identifier, nothing
	# about any cluster. Unauthenticated is still not public -- narrow them to
	# the hosts that actually probe.
	@probes {
		path /healthz /readyz
		remote_ip 127.0.0.1/32 10.0.0.0/8
	}
	handle @probes {
		reverse_proxy 127.0.0.1:8080
	}

	# The endpoints of oauth2-proxy itself (/oauth2/start, /oauth2/callback,
	# /oauth2/sign_out). Authelia or any other forward-auth component fits the
	# same shape, with its own paths and port.
	handle /oauth2/* {
		reverse_proxy 127.0.0.1:4180
	}

	# Everything else, and that INCLUDES /metrics. The Prometheus exposition
	# names every configured cluster and says when each was last reachable: it
	# describes the estate, so it is authenticated like the API, unlike the two
	# probes above. A scraper is a client like any other and gets credentials of
	# its own. The frontend bundle is protected for the same reason: it is the
	# topology of the estate rendered as a page.
	handle {
		forward_auth 127.0.0.1:4180 {
			uri /oauth2/auth
			# The identity moxy will read, taken from the answer of the
			# authenticating component and from nowhere else.
			copy_headers X-Auth-Request-User>X-Forwarded-User

			# A browser gets a login page instead of a bare 401.
			@unauthenticated status 401
			handle_response @unauthenticated {
				redir * /oauth2/start?rd={scheme}://{host}{uri}
			}
		}

		# Caddy passes the public Host through, so moxyd has to know that name:
		# -allowed-hosts moxy.interne.example (see deploy/moxyd.service). The
		# alternative is to rewrite it here with
		#   reverse_proxy 127.0.0.1:8080 { header_up Host {upstream_hostport} }
		# which needs no flag but hides the public name from moxy's logs.
		reverse_proxy 127.0.0.1:8080
	}

	# moxyd already sets Content-Security-Policy, Referrer-Policy,
	# X-Frame-Options, Permissions-Policy and nosniff on the page it serves. Do
	# not add a second set here: two policies for one page is how a frontend
	# ends up half blocked. HSTS is the proxy's to add, because the proxy is
	# what terminates TLS.
	header Strict-Transport-Security "max-age=63072000; includeSubDomains"
}

# --- Isolated workstation, no identity provider ------------------------------
# HTTP basic authentication is enough when there is one operator and no OIDC to
# talk to. It is real authentication, and moxy still gets a name to trust: Caddy
# exposes the authenticated user as {http.auth.user.id}. The "auth" block of
# config.json is the same one.
#
#	moxy.interne.example {
#		request_header -X-Forwarded-User
#
#		@probes {
#			path /healthz /readyz
#			remote_ip 127.0.0.1/32
#		}
#		handle @probes {
#			reverse_proxy 127.0.0.1:8080
#		}
#
#		handle {
#			# caddy hash-password prints the bcrypt hash to paste here.
#			basic_auth {
#				operator $2a$14$...
#			}
#			reverse_proxy 127.0.0.1:8080 {
#				header_up X-Forwarded-User {http.auth.user.id}
#			}
#		}
#	}
