# Build context for Containerfile. Everything the image needs is rebuilt inside
# the stages, so local artifacts must stay out: a stale bin/moxyd or dist/ would
# otherwise be copied into the image ahead of the fresh build output.
.git
.github
.claude
bin
apps/web/dist
apps/web/node_modules
**/*.tsbuildinfo
docs

# Local configuration names real hosts and token ids, and .env files may hold
# token secrets. None of it belongs in an image layer.
config.example.json
config.local.json
*.local.json
.env
.env.*

# Tests never enter a layer, and leaving them in the context is not free: they
# sit under the same COPY as the sources, so a commit touching only a _test.go
# or a .test.tsx invalidates the build stage and, with it, the type=gha cache
# of a workflow that was about to prove nothing new. Excluding them makes the
# cache key follow what is actually compiled.
**/*_test.go
**/testdata
apps/web/src/**/*.test.ts
apps/web/src/**/*.test.tsx
apps/web/src/test

# Prose, for the same reason: none of it is copied into an image.
README.md
apps/web/README.md
CLAUDE.md
Makefile
