{
  // The application and its tests: everything that runs in a browser, or in
  // jsdom pretending to be one. No "node" in `types`: code that reaches for
  // `process` here is code that will fail in the bundle.
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "types": ["vite/client", "vitest/globals", "@testing-library/jest-dom"],
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedIndexedAccess": true,
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "noEmit": true,
    "composite": true,
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.tsbuildinfo",
    "paths": { "@/*": ["./src/*"] }
  },
  "include": ["src"],
  // The one test that reads a file from disk. It runs in Node under Vitest,
  // not in jsdom, so it belongs to the Node program below — and giving the
  // whole application `process` and `Buffer` for its sake is what this split
  // exists to avoid.
  "exclude": ["src/styles/tokens.test.ts"]
}
